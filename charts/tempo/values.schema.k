schema ValuesMetricsGenerator:
    r"""
    Configuration for the metrics-generator

    Attributes
    ----------
    affinity : str, optional, default is "podAntiAffinity:\n  requiredDuringSchedulingIgnoredDuringExecution:\n    - labelSelector:\n        matchLabels:\n          {{- include \"tempo.selectorLabels\" (dict \"ctx\" . \"component\" \"metrics-generator\") | nindent 10 }}\n      topologyKey: kubernetes.io/hostname\n  preferredDuringSchedulingIgnoredDuringExecution:\n    - weight: 100\n      podAffinityTerm:\n        labelSelector:\n          matchLabels:\n            {{- include \"tempo.selectorLabels\" (dict \"ctx\" . \"component\" \"metrics-generator\") | nindent 12 }}\n        topologyKey: topology.kubernetes.io/zone\n"
        Affinity for metrics-generator pods. Passed through `tpl` and, thus, to be configured as string
    annotations : ValuesMetricsGeneratorAnnotations, optional
        Annotations for the metrics-generator StatefulSet
    appProtocol : ValuesMetricsGeneratorAppProtocol, optional
        Adds the appProtocol field to the metricsGenerator service. This allows metricsGenerator to work with istio protocol selection.
    config : ValuesMetricsGeneratorConfig, optional
        More information on configuration: https://grafana.com/docs/tempo/latest/configuration/#metrics-generator
    dnsConfig : ValuesMetricsGeneratorDnsConfig, optional
         - ip: 1.2.3.4
           hostnames:
             - domain.tld
        Pod DNS config for this component. Falls back to `defaults.dnsConfig`, then `tempo.dnsConfig`.
    enabled : bool, optional, default is False
        Specifies whether a metrics-generator should be deployed
    extraArgs : [any], optional
        Additional CLI args for the metrics-generator
    extraContainers : [any], optional
        Containers to add to the metrics-generator pods
    extraEnv : [any], optional
        Environment variables to add to the metrics-generator pods
    extraEnvFrom : [any], optional
        Environment variables from secrets or configmaps to add to the metrics-generator pods
    extraVolumeMounts : [any], optional
        # Here shows how to configure 1Gi memory as emptyDir.
        # Ref: https://kubernetes.io/docs/reference/generated/kubernetes-api/v1.19/#emptydirvolumesource-v1-core
        medium: "Memory"
        sizeLimit: 1Gi
        Extra volumes for metrics-generator pods
    extraVolumes : [any], optional
        Extra volumes for metrics-generator deployment
    hostAliases : [any], optional
        hostAliases to add
    image : ValuesMetricsGeneratorImage, optional
    initContainers : [any], optional
        Init containers for the metrics generator pod
    kind : str, optional, default is "Deployment"
        Kind of deployment [StatefulSet/Deployment]
    maxUnavailable : int, optional, default is 1
        Pod Disruption Budget maxUnavailable
    minReadySeconds : int, optional, default is 10
        Minimum number of seconds for which a newly created Pod should be ready without any of its containers crashing/terminating
    nodeSelector : ValuesMetricsGeneratorNodeSelector, optional
        Node selector for metrics-generator pods
    persistence : ValuesMetricsGeneratorPersistence, optional
        Persistence configuration for metrics-generator
    persistentVolumeClaimRetentionPolicy : ValuesMetricsGeneratorPersistentVolumeClaimRetentionPolicy, optional
    podAnnotations : ValuesMetricsGeneratorPodAnnotations, optional
        Annotations for metrics-generator pods
    podDisruptionBudget : ValuesMetricsGeneratorPodDisruptionBudget, optional
        Pod Disruption Budget configuration
    podLabels : ValuesMetricsGeneratorPodLabels, optional
        Labels for metrics-generator pods
    ports : [ValuesMetricsGeneratorPortsItems0], optional
        Default ports
    priorityClassName : any, optional, default is "null"
        The name of the PriorityClass for metrics-generator pods
    replicas : int, optional, default is 1
        Number of replicas for the metrics-generator
    resources : ValuesMetricsGeneratorResources, optional
        Resource requests and limits for the metrics-generator
    service : ValuesMetricsGeneratorService, optional
    serviceDiscovery : ValuesMetricsGeneratorServiceDiscovery, optional
    terminationGracePeriodSeconds : int, optional, default is 300
        Grace period to allow the metrics-generator to shutdown before it is killed. Especially for the ingestor,
        this must be increased. It must be long enough so metrics-generators can be gracefully shutdown flushing/transferring
        all data and to successfully leave the member ring on shutdown.
    tolerations : [any], optional
        Tolerations for metrics-generator pods
    topologySpreadConstraints : str, optional, default is "- maxSkew: 1\n  topologyKey: topology.kubernetes.io/zone\n  whenUnsatisfiable: ScheduleAnyway\n  labelSelector:\n    matchLabels:\n      {{- include \"tempo.selectorLabels\" (dict \"ctx\" . \"component\" \"metrics-generator\") | nindent 6 }}\n"
        topologySpread for metrics-generator pods. Passed through `tpl` and, thus, to be configured as string
    walEmptyDir : ValuesMetricsGeneratorWalEmptyDir, optional
        The EmptyDir location where the /var/tempo will be mounted on. Defaults to local disk, can be set to memory.
    """

    affinity?: str
    annotations?: ValuesMetricsGeneratorAnnotations
    appProtocol?: ValuesMetricsGeneratorAppProtocol
    config?: ValuesMetricsGeneratorConfig
    dnsConfig?: ValuesMetricsGeneratorDnsConfig
    enabled?: bool
    extraArgs?: [any]
    extraContainers?: [any]
    extraEnv?: [any]
    extraEnvFrom?: [any]
    extraVolumeMounts?: [any]
    extraVolumes?: [any]
    hostAliases?: [any]
    image?: ValuesMetricsGeneratorImage
    initContainers?: [any]
    kind?: str
    maxUnavailable?: int
    minReadySeconds?: int
    nodeSelector?: ValuesMetricsGeneratorNodeSelector
    persistence?: ValuesMetricsGeneratorPersistence
    persistentVolumeClaimRetentionPolicy?: ValuesMetricsGeneratorPersistentVolumeClaimRetentionPolicy
    podAnnotations?: ValuesMetricsGeneratorPodAnnotations
    podDisruptionBudget?: ValuesMetricsGeneratorPodDisruptionBudget
    podLabels?: ValuesMetricsGeneratorPodLabels
    ports?: [ValuesMetricsGeneratorPortsItems0]
    priorityClassName?: any
    replicas?: int
