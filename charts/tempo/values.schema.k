    Attributes
    ----------
    digest : any, optional, default is "null"
        Overrides the image tag with an image digest
    pullPolicy : str, optional, default is "IfNotPresent"
        Docker image pull policy
    registry : str, optional, default is "us-docker.pkg.dev"
        The Docker registry
    repository : str, optional, default is "grafanalabs-global/docker-enterprise-provisioner-prod/enterprise-provisioner"
