schema ValuesGateway:
    r"""
    Configuration for the gateway

    Attributes
    ----------
    affinity : str, optional, default is "podAntiAffinity:\n  requiredDuringSchedulingIgnoredDuringExecution:\n    - labelSelector:\n        matchLabels:\n          {{- include \"tempo.selectorLabels\" (dict \"ctx\" . \"component\" \"gateway\") | nindent 10 }}\n      topologyKey: kubernetes.io/hostname\n  preferredDuringSchedulingIgnoredDuringExecution:\n    - weight: 100\n      podAffinityTerm:\n        labelSelector:\n          matchLabels:\n            {{- include \"tempo.selectorLabels\" (dict \"ctx\" . \"component\" \"gateway\") | nindent 12 }}\n        topologyKey: topology.kubernetes.io/zone\n"
        Affinity for gateway pods. Passed through `tpl` and, thus, to be configured as string
    annotations : ValuesGatewayAnnotations, optional
        Annotations for gateway deployment
    autoscaling : ValuesGatewayAutoscaling, optional
         - ip: 1.2.3.4
           hostnames:
             - domain.tld
    basicAuth : ValuesGatewayBasicAuth, optional
        Basic auth configuration
    enabled : bool, optional, default is False
        Specifies whether the gateway should be enabled
    extraArgs : [any], optional
        Additional CLI args for the gateway
    extraContainers : [any], optional
        Containers to add to the gateway pods
    extraEnv : [any], optional
        Environment variables to add to the gateway pods
    extraEnvFrom : [any], optional
        Environment variables from secrets or configmaps to add to the gateway pods
    extraVolumeMounts : [any], optional
        Volume mounts to add to the gateway pods
    extraVolumes : [any], optional
        Volumes to add to the gateway pods
    hostAliases : [any], optional
        hostAliases to add
    image : ValuesGatewayImage, optional
    ingress : ValuesGatewayIngress, optional
        Gateway ingress configuration
    livenessProbe : ValuesGatewayLivenessProbe, optional
        Configures the liveness probe for the gateway
    maxUnavailable : int, optional, default is 1
        Pod Disruption Budget maxUnavailable
    minReadySeconds : int, optional, default is 10
        Minimum number of seconds for which a newly created Pod should be ready without any of its containers crashing/terminating
    nginxConfig : ValuesGatewayNginxConfig, optional
    nodeSelector : ValuesGatewayNodeSelector, optional
        Node selector for gateway pods
    podAnnotations : ValuesGatewayPodAnnotations, optional
        Annotations for gateway pods
    podDisruptionBudget : ValuesGatewayPodDisruptionBudget, optional
        Pod Disruption Budget configuration
    podLabels : ValuesGatewayPodLabels, optional
        Labels for gateway pods
    priorityClassName : any, optional, default is "null"
        The name of the PriorityClass for gateway pods
    readinessProbe : ValuesGatewayReadinessProbe, optional
        Configures the readiness probe for the gateway
    replicas : int, optional, default is 1
        Number of replicas for the gateway
    resources : ValuesGatewayResources, optional
        Resource requests and limits for the gateway
    route : ValuesGatewayRoute, optional
        Gateway API route configuration for the gateway.
        Multiple routes can be added by adding a dictionary key like the 'main' route.
    service : ValuesGatewayService, optional
        Gateway service configuration
    terminationGracePeriodSeconds : int, optional, default is 30
        Grace period to allow the gateway to shutdown before it is killed
    tolerations : [any], optional
        Tolerations for gateway pods
    topologySpreadConstraints : str, optional, default is "- maxSkew: 1\n  topologyKey: topology.kubernetes.io/zone\n  whenUnsatisfiable: ScheduleAnyway\n  labelSelector:\n    matchLabels:\n      {{- include \"tempo.selectorLabels\" (dict \"ctx\" . \"component\" \"gateway\") | nindent 6 }}\n"
        topologySpread for gateway pods. Passed through `tpl` and, thus, to be configured as string
    verboseLogging : bool, optional, default is True
        Enable logging of 2xx and 3xx HTTP requests
    """

    affinity?: str
    annotations?: ValuesGatewayAnnotations
    autoscaling?: ValuesGatewayAutoscaling
    basicAuth?: ValuesGatewayBasicAuth
    enabled?: bool
    extraArgs?: [any]
    extraContainers?: [any]
    extraEnv?: [any]
    extraEnvFrom?: [any]
    extraVolumeMounts?: [any]
    extraVolumes?: [any]
    hostAliases?: [any]
    image?: ValuesGatewayImage
    ingress?: ValuesGatewayIngress
    livenessProbe?: ValuesGatewayLivenessProbe
    maxUnavailable?: int
    minReadySeconds?: int
    nginxConfig?: ValuesGatewayNginxConfig
    nodeSelector?: ValuesGatewayNodeSelector
    podAnnotations?: ValuesGatewayPodAnnotations
    podDisruptionBudget?: ValuesGatewayPodDisruptionBudget
    podLabels?: ValuesGatewayPodLabels
    priorityClassName?: any
    readinessProbe?: ValuesGatewayReadinessProbe
    replicas?: int
    resources?: ValuesGatewayResources
    route?: ValuesGatewayRoute
    service?: ValuesGatewayService
    terminationGracePeriodSeconds?: int
    tolerations?: [any]
    topologySpreadConstraints?: str
    verboseLogging?: bool
    [...str]: any

