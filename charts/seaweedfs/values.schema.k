    objectLock enables S3 Object Lock (irreversible, forces versioning)
    versioning: Enabled or Suspended (or bool true/false)
    createBuckets:
      - name: bucket-a
        anonymousRead: true
        ttl: 7d
        objectLock: true
        versioning: Enabled
      - name: bucket-b
        anonymousRead: false

