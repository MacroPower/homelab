    volumeWrite : bool, optional, default is True
    """
    [...str]: any
    expiresAfterSeconds?: ValuesGlobalSeaweedfsSecurityConfigJwtSigningExpiresAfterSeconds
    filerRead?: bool
    filerWrite?: bool
    volumeRead?: bool
    volumeWrite?: bool

