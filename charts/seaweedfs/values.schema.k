schema ValuesVolume:
    r"""
    ValuesVolume

    Attributes
    ----------
    affinity : str, optional, default is "podAntiAffinity:\n  requiredDuringSchedulingIgnoredDuringExecution:\n    - labelSelector:\n        matchLabels:\n          app.kubernetes.io/name: {{ template \"seaweedfs.name\" . }}\n          app.kubernetes.io/instance: {{ .Release.Name }}\n          app.kubernetes.io/component: {{ $volumeName }}\n      topologyKey: kubernetes.io/hostname\n"
        Affinity Settings
        Commenting out or setting as empty the affinity variable, will allow
        deployment to single node services such as Minikube
    annotations : ValuesVolumeAnnotations, optional
        Annotations to be added to the volume resources
    compactionMBps : str, optional, default is "50"
        limit background compaction or copying speed in mega bytes per second
    containerSecurityContext : ValuesVolumeContainerSecurityContext, optional
        Configure security context for Container
        ref: https://kubernetes.io/docs/tasks/configure-pod-container/security-context/
        Example:
        containerSecurityContext:
          enabled: true
          runAsUser: 2000
          allowPrivilegeEscalation: false
    dataCenter : any, optional, default is "null"
        Volume server's data center name
    dataDirs : [ValuesVolumeDataDirsItems0], optional
        For each data disk you may use ANY storage-class, example with local-path-provisioner
        Annotations are optional.
         dataDirs:
          - name: data
            type: "persistentVolumeClaim"
            size: "24Ti"
            storageClass: "local-path-provisioner"
            annotations:
             "key": "value"
            maxVolumes: 0  # If set to zero on non-windows OS, the limit will be auto configured. (default "7")

        You may also specify an existing claim:
          - name: data
            type: "existingClaim"
            claimName: "my-pvc"
            maxVolumes: 0  # If set to zero on non-windows OS, the limit will be auto configured. (default "7")

        You can also use emptyDir storage:
          - name: data
            type: "emptyDir"
            maxVolumes: 0  # If set to zero on non-windows OS, the limit will be auto configured. (default "7")

        If these don't meet your needs, you can use "custom" here along with extraVolumes and extraVolumeMounts
        Particularly useful when using more than 1 for the volume server replicas.
          - name: data
            type: "custom"
            maxVolumes: 0  # If set to zero on non-windows OS, the limit will be auto configured. (default "7")
    enabled : bool, optional, default is True
    extraArgs : [any], optional
        Custom command line arguments to add to the volume command
        Example to fix IPv6 metrics connectivity issues:
        extraArgs: ["-metricsIp", "0.0.0.0"]
        Example with multiple args:
        extraArgs: ["-customFlag", "value", "-anotherFlag"]
    extraEnvironmentVars : any, optional, default is ""
    extraVolumeMounts : str, optional, default is ""
    extraVolumes : str, optional, default is ""
        Example for use when using more than 1 volume server replica
        extraVolumeMounts: |
          - name: drive
            mountPath: /drive
            subPathExpr: $(POD_NAME)
        extraVolumes: |
          - name: drive
            hostPath:
              path: /var/mnt/
    fileSizeLimitMB : any, optional, default is "null"
        limit file size to avoid out of memory, default 256mb
    grpcPort : int, optional, default is 18080
    id : any, optional, default is "null"
        Stable identifier for the volume server, independent of IP address
        Useful for Kubernetes environments with hostPath volumes to maintain stable identity
    idx : ValuesVolumeIdx, optional
        idx (the volume index) may use a separate PERSISTENT volume:

        idx:
         type: "hostPath"
         hostPathPrefix: /ssd

        or

        idx:
         type: "persistentVolumeClaim"
         size: "20Gi"
         storageClass: "local-path-provisioner"

        or

        idx:
          type: "existingClaim"
          claimName: "myClaim"

        "emptyDir" is rejected for idx (the chart fails to render): an ephemeral
        index is wiped on every restart while the data persists, forcing a full
        rebuild each start (a fatal crash on older versions). "logs" may still use
        any of the above or emptyDir.

        Default {} keeps the index next to the data, so it persists with the data and
        needs no separate volume. Recommended unless you must split the index onto
        its own persistent storage.
    idxVolMoveResources : ValuesVolumeIdxVolMoveResources, optional
        Resource requests, limits, etc. for the vol-move-idx initContainer. This
        should map directly to the value of the resources field for a PodSpec,
        formatted as a multi-line string. By default no direct resource request
        is made.
    imageOverride : any, optional, default is "null"
    imagesFixOrientation : bool, optional, default is False
        Adjust jpg orientation when uploading.
    index : any, optional, default is "null"
        Choose [memory|leveldb|leveldbMedium|leveldbLarge] mode for memory~performance balance., default memory
    ingress : ValuesVolumeIngress, optional
    initContainers : str, optional, default is ""
    ipBind : str, optional, default is "0.0.0.0"
    livenessProbe : ValuesVolumeLivenessProbe, optional
        used to configure livenessProbe on volume-server containers

    loggingOverrideLevel : any, optional, default is "null"
    logs : ValuesVolumeLogs, optional
    metricsIp : str, optional, default is ""
    metricsPort : int, optional, default is 9327
    minFreeSpacePercent : int, optional, default is 1
        minimum free disk space(in percents). If free disk space lower this value - all volumes marks as ReadOnly
    nodeSelector : str, optional, default is ""
        nodeSelector labels for server pod assignment, formatted as a muli-line string.
        ref: https://kubernetes.io/docs/concepts/configuration/assign-pod-node/#nodeselector
        Example:
    podAnnotations : ValuesVolumePodAnnotations, optional
        Annotations to be added to the volume pods
    podLabels : ValuesVolumePodLabels, optional
        Labels to be added to the volume pods
    podManagementPolicy : str, optional, default is "Parallel"
        # Set podManagementPolicy
    podSecurityContext : ValuesVolumePodSecurityContext, optional
        Configure security context for Pod
        ref: https://kubernetes.io/docs/tasks/configure-pod-container/security-context/
        Example:
        podSecurityContext:
          enabled: true
          runAsUser: 1000
          runAsGroup: 3000
          fsGroup: 2000
    port : int, optional, default is 8080
    priorityClassName : str, optional, default is ""
        used to assign priority to server pods
        ref: https://kubernetes.io/docs/concepts/configuration/pod-priority-preemption/
    pulseSeconds : any, optional, default is "null"
        number of seconds between heartbeats, must be smaller than or equal to the master's setting
    rack : any, optional, default is "null"
        Volume server's rack name
    readMode : str, optional, default is "proxy"
        Redirect moved or non-local volumes. (default proxy)
    readinessProbe : ValuesVolumeReadinessProbe, optional
        used to configure readinessProbe on volume-server containers

    replicas : int, optional, default is 1
    resizeHook : ValuesVolumeResizeHook, optional
        This will automatically create a job for patching Kubernetes resources if the dataDirs type is 'persistentVolumeClaim' and the size has changed.
    resources : ValuesVolumeResources, optional
        Resource requests, limits, etc. for the server cluster placement. This
        should map directly to the value of the resources field for a PodSpec,
        formatted as a multi-line string. By default no direct resource request
        is made.
    restartPolicy : any, optional, default is "null"
    rust : bool, optional, default is False
        Run the Rust volume server (/usr/bin/weed-volume) instead of the Go one.
        Requires an image that ships the Rust binary (amd64/arm64). The Go-only
        log flags (-logtostderr/-logdir/-v) and -pulseSeconds are dropped; set log
        level via the RUST_LOG env var in extraEnvironmentVars if needed.
    schedulerName : str, optional, default is ""
        used to specify a custom scheduler for volume pods
        ref: https://kubernetes.io/docs/concepts/scheduling-eviction/kube-scheduler/
    serviceAccountName : str, optional, default is ""
        used to assign a service account.
        ref: https://kubernetes.io/docs/tasks/configure-pod-container/configure-service-account/
    sidecars : [any], optional
        #
        # e.g:
        # sidecars:
        #   - name: your-image-name
        #     image: your-image
        #     imagePullPolicy: Always
        #     ports:
        #       - name: portname
        #         containerPort: 1234
        #
    tolerations : str, optional, default is ""
        Toleration Settings for server pods
        This should be a multi-line string matching the Toleration array
        in a PodSpec.
    topologySpreadConstraints : str, optional, default is ""
        Topology Spread Constraints Settings
        This should map directly to the value of the topologySpreadConstraints
        for a PodSpec. By Default no constraints are set.
    whiteList : any, optional, default is "null"
        Comma separated Ip addresses having write permission. No limit if empty.
    """
    [...str]: any
    affinity?: str
    annotations?: ValuesVolumeAnnotations
    compactionMBps?: str
    containerSecurityContext?: ValuesVolumeContainerSecurityContext
    dataCenter?: any
    dataDirs?: [ValuesVolumeDataDirsItems0]
    enabled?: bool
    extraArgs?: [any]
    extraEnvironmentVars?: any
    extraVolumeMounts?: str
    extraVolumes?: str
    fileSizeLimitMB?: any
    grpcPort?: int
    id?: any
    idx?: ValuesVolumeIdx
    idxVolMoveResources?: ValuesVolumeIdxVolMoveResources
    imageOverride?: any
    imagesFixOrientation?: bool
    index?: any
    ingress?: ValuesVolumeIngress
    initContainers?: str
    ipBind?: str
    livenessProbe?: ValuesVolumeLivenessProbe
    loggingOverrideLevel?: any
    logs?: ValuesVolumeLogs
    metricsIp?: str
    metricsPort?: int
    minFreeSpacePercent?: int
    nodeSelector?: str
    podAnnotations?: ValuesVolumePodAnnotations
    podLabels?: ValuesVolumePodLabels
    podManagementPolicy?: str
    podSecurityContext?: ValuesVolumePodSecurityContext
    port?: int
    priorityClassName?: str
    pulseSeconds?: any
    rack?: any
    readMode?: str
    readinessProbe?: ValuesVolumeReadinessProbe
    replicas?: int
    resizeHook?: ValuesVolumeResizeHook
    resources?: ValuesVolumeResources
    restartPolicy?: any
    rust?: bool
    schedulerName?: str
    serviceAccountName?: str
    sidecars?: [any]
    tolerations?: str
    topologySpreadConstraints?: str
    whiteList?: any

