schema ValuesMaster:
    r"""
    ValuesMaster

    Attributes
    ----------
    affinity : str, optional, default is "podAntiAffinity:\n  requiredDuringSchedulingIgnoredDuringExecution:\n    - labelSelector:\n        matchLabels:\n          app.kubernetes.io/name: {{ template \"seaweedfs.name\" . }}\n          app.kubernetes.io/instance: {{ .Release.Name }}\n          app.kubernetes.io/component: master\n      topologyKey: kubernetes.io/hostname\n"
        Affinity Settings
        Commenting out or setting as empty the affinity variable, will allow
        deployment to single node services such as Minikube
    annotations : ValuesMasterAnnotations, optional
        Annotations to be added to the master resources
    config : str, optional, default is "# Enter any extra configuration for master.toml here.\n# It may be a multi-line string."
    containerSecurityContext : ValuesMasterContainerSecurityContext, optional
        Configure security context for Container
        ref: https://kubernetes.io/docs/tasks/configure-pod-container/security-context/
        Example:
        containerSecurityContext:
          enabled: true
          runAsUser: 2000
          allowPrivilegeEscalation: false
    data : ValuesMasterData, optional
        You may use ANY storage-class, example with local-path-provisioner
        Annotations are optional.
         data:
           type: "persistentVolumeClaim"
           size: "24Ti"
           storageClass: "local-path-provisioner"
           annotations:
             "key": "value"

        You may also specify an existing claim:
         data:
           type: "existingClaim"
           claimName: "my-pvc"

        You can also use emptyDir storage:
         data:
           type: "emptyDir"
        -mdir holds the Raft log and snapshots, and with them the cluster's
        identity (its topology UUID). A hostPath does not follow a rescheduled pod,
        so prefer type "persistentVolumeClaim" for new installs. The default stays
        hostPath so existing releases keep upgrading; see the README to switch one.
    defaultReplication : str, optional, default is "000"
         replication type is XYZ:
        X number of replica in other data centers
        Y number of replica in other racks in the same data center
        Z number of replica in other servers in the same rack
    disableHttp : bool, optional, default is False
        Disable http request, only gRpc operations are allowed
    electionTimeout : str, optional, default is "10s"
        election timeout of master servers
    enabled : bool, optional, default is True
    extraArgs : [any], optional
        Custom command line arguments to add to the master command
        Example to fix IPv6 metrics connectivity issues:
        extraArgs: ["-metricsIp", "0.0.0.0"]
        Example with multiple args:
        extraArgs: ["-customFlag", "value", "-anotherFlag"]
    extraEnvironmentVars : ValuesMasterExtraEnvironmentVars, optional
    extraVolumeMounts : str, optional, default is ""
    extraVolumes : str, optional, default is ""
    garbageThreshold : any, optional, default is "null"
        threshold to vacuum and reclaim spaces, default 0.3 (30%)
    grpcPort : int, optional, default is 19333
    heartbeatInterval : str, optional, default is "300ms"
        heartbeat interval of master servers, and will be randomly multiplied by [1, 1.25)
    imageOverride : any, optional, default is "null"
    ingress : ValuesMasterIngress, optional
    initContainers : str, optional, default is ""
    ipBind : str, optional, default is "0.0.0.0"
    livenessProbe : ValuesMasterLivenessProbe, optional
        used to configure livenessProbe on master-server containers

    loggingOverrideLevel : any, optional, default is "null"
    logs : ValuesMasterLogs, optional
        You can also use emptyDir storage:
         logs:
           type: "emptyDir"
    metricsIntervalSec : int, optional, default is 15
        Prometheus push interval in seconds, default 15
    metricsIp : str, optional, default is ""
    metricsPort : int, optional, default is 9327
    nodeSelector : str, optional, default is ""
        nodeSelector labels for master pod assignment, formatted as a muli-line string.
        ref: https://kubernetes.io/docs/concepts/configuration/assign-pod-node/#nodeselector
        Example:
    podAnnotations : ValuesMasterPodAnnotations, optional
        Annotations to be added to the master pods
    podLabels : ValuesMasterPodLabels, optional
        Labels to be added to the master pods
    podManagementPolicy : str, optional, default is "Parallel"
        # Set podManagementPolicy
    podSecurityContext : ValuesMasterPodSecurityContext, optional
        Configure security context for Pod
        ref: https://kubernetes.io/docs/tasks/configure-pod-container/security-context/
        Example:
        podSecurityContext:
          enabled: true
          runAsUser: 1000
          runAsGroup: 3000
          fsGroup: 2000
    port : int, optional, default is 9333
    priorityClassName : str, optional, default is ""
        used to assign priority to master pods
        ref: https://kubernetes.io/docs/concepts/configuration/pod-priority-preemption/
    raftBootstrap : bool, optional, default is False
        Whether to bootstrap the Raft cluster. Only use it when use Hashicorp Raft
    raftHashicorp : bool, optional, default is False
        Use Hashicorp Raft
    readinessProbe : ValuesMasterReadinessProbe, optional
        used to configure readinessProbe on master-server containers

    replicas : int, optional, default is 1
    resources : ValuesMasterResources, optional
        Resource requests, limits, etc. for the master cluster placement. This
        should map directly to the value of the resources field for a PodSpec,
        formatted as a multi-line string. By default no direct resource request
        is made.
    restartPolicy : any, optional, default is "null"
    resumeState : bool, optional, default is False
        Resume previous state on start master server
    schedulerName : str, optional, default is ""
        used to specify a custom scheduler for master pods
        ref: https://kubernetes.io/docs/concepts/scheduling-eviction/kube-scheduler/
    serviceAccountName : str, optional, default is ""
        used to assign a service account.
        ref: https://kubernetes.io/docs/tasks/configure-pod-container/configure-service-account/
    sidecars : [any], optional
        #
        # e.g:
        # sidecars:
        #   - name: your-image-name
        #     image: your-image
        #     imagePullPolicy: Always
        #     ports:
        #       - name: portname
        #         containerPort: 1234
        #
    tolerations : str, optional, default is ""
        Toleration Settings for master pods
        This should be a multi-line string matching the Toleration array
        in a PodSpec.
    topologySpreadConstraints : str, optional, default is ""
        Topology Spread Constraints Settings
        This should map directly to the value of the topologySpreadConstraints
        for a PodSpec. By Default no constraints are set.
    updatePartition : int, optional, default is 0
        updatePartition is used to control a careful rolling update of SeaweedFS
        masters.
    volumePreallocate : bool, optional, default is False
    volumeSizeLimitMB : int, optional, default is 1000
    """
    [...str]: any
    affinity?: str
    annotations?: ValuesMasterAnnotations
    config?: str
    containerSecurityContext?: ValuesMasterContainerSecurityContext
    data?: ValuesMasterData
    defaultReplication?: str
    disableHttp?: bool
    electionTimeout?: str
    enabled?: bool
    extraArgs?: [any]
    extraEnvironmentVars?: ValuesMasterExtraEnvironmentVars
    extraVolumeMounts?: str
    extraVolumes?: str
    garbageThreshold?: any
    grpcPort?: int
    heartbeatInterval?: str
    imageOverride?: any
    ingress?: ValuesMasterIngress
    initContainers?: str
    ipBind?: str
    livenessProbe?: ValuesMasterLivenessProbe
    loggingOverrideLevel?: any
    logs?: ValuesMasterLogs
    metricsIntervalSec?: int
    metricsIp?: str
    metricsPort?: int
    nodeSelector?: str
    podAnnotations?: ValuesMasterPodAnnotations
    podLabels?: ValuesMasterPodLabels
    podManagementPolicy?: str
    podSecurityContext?: ValuesMasterPodSecurityContext
    port?: int
    priorityClassName?: str
    raftBootstrap?: bool
    raftHashicorp?: bool
    readinessProbe?: ValuesMasterReadinessProbe
    replicas?: int
    resources?: ValuesMasterResources
    restartPolicy?: any
    resumeState?: bool
    schedulerName?: str
    serviceAccountName?: str
    sidecars?: [any]
    tolerations?: str
    topologySpreadConstraints?: str
    updatePartition?: int
    volumePreallocate?: bool
    volumeSizeLimitMB?: int

