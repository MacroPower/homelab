    renewBefore?: str

schema ValuesCertificatesExternalCertificates:
    r"""
    ValuesCertificatesExternalCertificates

    Attributes
    ----------
    enabled : bool, optional, default is False
        This will avoid the need to use cert-manager and will rely on providing your own external certificates and CA
        you will need to store your provided certificates in the secret read by the different services:
        seaweedfs-master-cert, seaweedfs-filer-cert, etc. Can see any statefulset definition to see secret names
    """
    [...str]: any
    enabled?: bool

schema ValuesCosi:
    r"""
    Deploy Kubernetes COSI Driver for SeaweedFS
    Requires COSI CRDs and controller to be installed in the cluster
    For more information, visit: https://container-object-storage-interface.github.io/docs/deployment-guide

    Attributes
    ----------
    bucketClassName : str, optional, default is "seaweedfs"
    bucketClassParameters : ValuesCosiBucketClassParameters, optional
        Optional parameters to pass to the default BucketClass (e.g., diskType for tiered storage)
    containerSecurityContext : ValuesCosiContainerSecurityContext, optional
    driverName : str, optional, default is "seaweedfs.objectstorage.k8s.io"
    enableAuth : bool, optional, default is False
        enable user & permission to s3 (need to inject to all services)
    enabled : bool, optional, default is False
    endpoint : str, optional, default is ""
    existingConfigSecret : any, optional, default is "null"
        set to the name of an existing kubernetes Secret with the s3 json config file
        should have a secret key called seaweedfs_s3_config with an inline json configure
    extraVolumeMounts : str, optional, default is ""
    extraVolumes : str, optional, default is ""
    image : str, optional, default is "ghcr.io/seaweedfs/seaweedfs-cosi-driver:v0.1.2"
    podSecurityContext : ValuesCosiPodSecurityContext, optional
    region : str, optional, default is ""
    resources : ValuesCosiResources, optional
        Resource requests, limits, etc. for the server cluster placement. This
        should map directly to the value of the resources field for a PodSpec,
        formatted as a multi-line string. By default no direct resource request
        is made.
    schedulerName : str, optional, default is ""
        used to assign a custom scheduler to cosi pods
        ref: https://kubernetes.io/docs/tasks/extend-kubernetes/configure-multiple-schedulers/
    sidecar : ValuesCosiSidecar, optional
    """
    [...str]: any
    bucketClassName?: str
    bucketClassParameters?: ValuesCosiBucketClassParameters
    containerSecurityContext?: ValuesCosiContainerSecurityContext
    driverName?: str
    enableAuth?: bool
    enabled?: bool
    endpoint?: str
    existingConfigSecret?: any
    extraVolumeMounts?: str
    extraVolumes?: str
    image?: str
    podSecurityContext?: ValuesCosiPodSecurityContext
    region?: str
    resources?: ValuesCosiResources
    schedulerName?: str
    sidecar?: ValuesCosiSidecar

schema ValuesCosiBucketClassParameters:
    r"""
    Optional parameters to pass to the default BucketClass (e.g., diskType for tiered storage)
    """
