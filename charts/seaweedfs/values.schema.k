schema ValuesFiler:
    r"""
    ValuesFiler

    Attributes
    ----------
    affinity : str, optional, default is "podAntiAffinity:\n  requiredDuringSchedulingIgnoredDuringExecution:\n    - labelSelector:\n        matchLabels:\n          app.kubernetes.io/name: {{ template \"seaweedfs.name\" . }}\n          app.kubernetes.io/instance: {{ .Release.Name }}\n          app.kubernetes.io/component: filer\n      topologyKey: kubernetes.io/hostname\n"
        Affinity Settings
        Commenting out or setting as empty the affinity variable, will allow
        deployment to single node services such as Minikube
    annotations : ValuesFilerAnnotations, optional
        Annotations to be added to the filer resource
    containerSecurityContext : ValuesFilerContainerSecurityContext, optional
        Configure security context for Container
        ref: https://kubernetes.io/docs/tasks/configure-pod-container/security-context/
        Example:
        containerSecurityContext:
          enabled: true
          runAsUser: 2000
          allowPrivilegeEscalation: false
    data : ValuesFilerData, optional
        You may use ANY storage-class, example with local-path-provisioner
        Annotations are optional.
         data:
           type: "persistentVolumeClaim"
           size: "24Ti"
           storageClass: "local-path-provisioner"
           annotations:
             "key": "value"

        You may also specify an existing claim:
         data:
           type: "existingClaim"
           claimName: "my-pvc"

        You can also use emptyDir storage:
         data:
           type: "emptyDir"
    dataCenter : any, optional, default is "null"
        prefer to read and write to volumes in this data center (not set by default)
    defaultReplicaPlacement : str, optional, default is "000"
         replication type is XYZ:
        X number of replica in other data centers
        Y number of replica in other racks in the same data center
        Z number of replica in other servers in the same rack
    dirListLimit : int, optional, default is 100000
        Limit sub dir listing size (default 100000)
    disableDirListing : bool, optional, default is False
        turn off directory listing
    disableHttp : bool, optional, default is False
        Disable http request, only gRpc operations are allowed
    enablePVC : bool, optional, default is False
        Settings for configuring stateful storage of filer pods.
        enablePVC will create a pvc for filer for data persistence.
    enabled : bool, optional, default is True
    encryptVolumeData : bool, optional, default is False
        encrypt data on volume servers
    extraArgs : [any], optional
        Custom command line arguments to add to the filer command
        Example to fix IPv6 metrics connectivity issues:
        extraArgs: ["-metricsIp", "0.0.0.0"]
        Example with multiple args:
        extraArgs: ["-customFlag", "value", "-anotherFlag"]
    extraEnvironmentVars : ValuesFilerExtraEnvironmentVars, optional
        extraEnvVars is a list of extra environment variables to set with the stateful set.
    extraVolumeMounts : str, optional, default is ""
    extraVolumes : str, optional, default is ""
    filerGroup : str, optional, default is ""
    grpcPort : int, optional, default is 18888
    imageOverride : any, optional, default is "null"
    ingresses : ValuesFilerIngresses, optional
    initContainers : str, optional, default is ""
    ipBind : str, optional, default is "0.0.0.0"
    livenessProbe : ValuesFilerLivenessProbe, optional
        used to configure livenessProbe on filer containers

    loggingOverrideLevel : any, optional, default is "null"
    logs : ValuesFilerLogs, optional
        You can also use emptyDir storage:
         logs:
           type: "emptyDir"
    maxMB : any, optional, default is "null"
        split files larger than the limit, default 32
    metricsIp : str, optional, default is ""
    metricsPort : int, optional, default is 9327
    nodeSelector : str, optional, default is ""
        nodeSelector labels for server pod assignment, formatted as a muli-line string.
        ref: https://kubernetes.io/docs/concepts/configuration/assign-pod-node/#nodeselector
        Example:
    notificationConfig : str, optional, default is ""
        Add a custom notification.toml to configure filer notifications
        Example:
        notificationConfig: |-
          [notification.kafka]
          enabled = false
          hosts = [
              "localhost:9092"
          ]
          topic = "seaweedfs_filer"
          offsetFile = "./last.offset"
          offsetSaveIntervalSeconds = 10
    podAnnotations : ValuesFilerPodAnnotations, optional
        Annotations to be added to the filer pods
    podLabels : ValuesFilerPodLabels, optional
        Labels to be added to the filer pods
    podManagementPolicy : str, optional, default is "Parallel"
        # Set podManagementPolicy
    podSecurityContext : ValuesFilerPodSecurityContext, optional
        Configure security context for Pod
        ref: https://kubernetes.io/docs/tasks/configure-pod-container/security-context/
        Example:
        podSecurityContext:
          enabled: true
          runAsUser: 1000
          runAsGroup: 3000
          fsGroup: 2000
    port : int, optional, default is 8888
    priorityClassName : str, optional, default is ""
        used to assign priority to server pods
        ref: https://kubernetes.io/docs/concepts/configuration/pod-priority-preemption/
    rack : any, optional, default is "null"
        prefer to write to volumes in this rack (not set by default)
    readinessProbe : ValuesFilerReadinessProbe, optional
        used to configure readinessProbe on filer containers

    redirectOnRead : bool, optional, default is False
        Whether proxy or redirect to volume server during file GET request
    replicas : int, optional, default is 1
    resources : ValuesFilerResources, optional
        Resource requests, limits, etc. for the server cluster placement. This
        should map directly to the value of the resources field for a PodSpec,
        formatted as a multi-line string. By default no direct resource request
        is made.
    restartPolicy : any, optional, default is "null"
    s3 : ValuesFilerS3, optional
    schedulerName : str, optional, default is ""
        used to specify a custom scheduler for filer pods
        ref: https://kubernetes.io/docs/concepts/scheduling-eviction/kube-scheduler/
    secretExtraEnvironmentVars : ValuesFilerSecretExtraEnvironmentVars, optional
        secret env variables
    serviceAccountName : str, optional, default is ""
        used to assign a service account.
        ref: https://kubernetes.io/docs/tasks/configure-pod-container/configure-service-account/
    sidecars : [any], optional
        #
        # e.g:
        # sidecars:
        #   - name: your-image-name
        #     image: your-image
        #     imagePullPolicy: Always
        #     ports:
        #       - name: portname
        #         containerPort: 1234
        #
    storage : str, optional, default is "25Gi"
        storage should be set to the disk size of the attached volume.
    storageClass : any, optional, default is "null"
        storageClass is the class of storage which defaults to null (the Kube cluster will pick the default).
    tolerations : str, optional, default is ""
        Toleration Settings for server pods
        This should be a multi-line string matching the Toleration array
        in a PodSpec.
    topologySpreadConstraints : str, optional, default is ""
        Topology Spread Constraints Settings
        This should map directly to the value of the topologySpreadConstraints
        for a PodSpec. By Default no constraints are set.
    updatePartition : int, optional, default is 0
        updatePartition is used to control a careful rolling update of SeaweedFS
        masters.
    """
    [...str]: any
    affinity?: str
    annotations?: ValuesFilerAnnotations
    containerSecurityContext?: ValuesFilerContainerSecurityContext
    data?: ValuesFilerData
    dataCenter?: any
    defaultReplicaPlacement?: str
    dirListLimit?: int
    disableDirListing?: bool
    disableHttp?: bool
    enablePVC?: bool
    enabled?: bool
    encryptVolumeData?: bool
    extraArgs?: [any]
    extraEnvironmentVars?: ValuesFilerExtraEnvironmentVars
    extraVolumeMounts?: str
    extraVolumes?: str
    filerGroup?: str
    grpcPort?: int
    imageOverride?: any
    ingresses?: ValuesFilerIngresses
    initContainers?: str
    ipBind?: str
    livenessProbe?: ValuesFilerLivenessProbe
    loggingOverrideLevel?: any
    logs?: ValuesFilerLogs
    maxMB?: any
    metricsIp?: str
    metricsPort?: int
    nodeSelector?: str
    notificationConfig?: str
    podAnnotations?: ValuesFilerPodAnnotations
    podLabels?: ValuesFilerPodLabels
    podManagementPolicy?: str
    podSecurityContext?: ValuesFilerPodSecurityContext
    port?: int
    priorityClassName?: str
    rack?: any
    readinessProbe?: ValuesFilerReadinessProbe
    redirectOnRead?: bool
    replicas?: int
    resources?: ValuesFilerResources
    restartPolicy?: any
    s3?: ValuesFilerS3
    schedulerName?: str
    secretExtraEnvironmentVars?: ValuesFilerSecretExtraEnvironmentVars
    serviceAccountName?: str
    sidecars?: [any]
    storage?: str
    storageClass?: any
    tolerations?: str
    topologySpreadConstraints?: str
    updatePartition?: int

schema ValuesFilerAnnotations:
    r"""
    Annotations to be added to the filer resource
    """
    [...str]: any

schema ValuesFilerContainerSecurityContext:
    r"""
    Configure security context for Container
    ref: https://kubernetes.io/docs/tasks/configure-pod-container/security-context/
    Example:
    containerSecurityContext:
      enabled: true
      runAsUser: 2000
      allowPrivilegeEscalation: false

    Attributes
    ----------
    allowPrivilegeEscalation : bool, optional
    capabilities : ValuesFilerContainerSecurityContextCapabilities, optional
    enabled : bool, optional
    runAsNonRoot : bool, optional
    seccompProfile : ValuesFilerContainerSecurityContextSeccompProfile, optional
    """
    [...str]: any
    allowPrivilegeEscalation?: bool
    capabilities?: ValuesFilerContainerSecurityContextCapabilities
    enabled?: bool
    runAsNonRoot?: bool
    seccompProfile?: ValuesFilerContainerSecurityContextSeccompProfile

schema ValuesFilerContainerSecurityContextCapabilities:
    r"""
    ValuesFilerContainerSecurityContextCapabilities

    Attributes
    ----------
    drop : [str], optional
    """
    [...str]: any
    drop?: [str]

schema ValuesFilerContainerSecurityContextSeccompProfile:
    r"""
    ValuesFilerContainerSecurityContextSeccompProfile

    Attributes
    ----------
    $type : str, optional
    """
    [...str]: any
    $type?: str

schema ValuesFilerData:
    r"""
    You may use ANY storage-class, example with local-path-provisioner
    Annotations are optional.
     data:
       type: "persistentVolumeClaim"
       size: "24Ti"
       storageClass: "local-path-provisioner"
       annotations:
         "key": "value"

    You may also specify an existing claim:
     data:
       type: "existingClaim"
       claimName: "my-pvc"

    You can also use emptyDir storage:
     data:
       type: "emptyDir"

    Attributes
    ----------
    hostPathPrefix : str, optional, default is "/storage"
    size : str, optional, default is ""
    storageClass : str, optional, default is ""
    $type : str, optional, default is "hostPath"
    """
    [...str]: any
    hostPathPrefix?: str
    size?: str
    storageClass?: str
    $type?: str

schema ValuesFilerExtraEnvironmentVars:
    r"""
    extraEnvVars is a list of extra environment variables to set with the stateful set.

    Attributes
    ----------
    WEED_FILER_BUCKETS_FOLDER : str, optional, default is "/buckets"
        directories under this folder will be automatically creating a separate bucket
    WEED_FILER_OPTIONS_RECURSIVE_DELETE : str, optional, default is "false"
        with http DELETE, by default the filer would check whether a folder is empty.
        recursive_delete will delete all sub folders and files, similar to "rm -Rf"
    WEED_LEVELDB2_ENABLED : str, optional, default is "true"
        if you want to use leveldb2, then should enable "enablePVC". or you may lose your data.
    WEED_MYSQL_CONNECTION_MAX_IDLE : str, optional, default is "5"
    WEED_MYSQL_CONNECTION_MAX_LIFETIME_SECONDS : str, optional, default is "600"
        "refresh" connection every 10 minutes, eliminating mysql closing "old" connections
    WEED_MYSQL_CONNECTION_MAX_OPEN : str, optional, default is "75"
    WEED_MYSQL_DATABASE : str, optional, default is "sw_database"
    WEED_MYSQL_ENABLED : str, optional, default is "false"
        the WEED_MYSQL_* keys and the db credential secret only render while this is "true"
    WEED_MYSQL_HOSTNAME : str, optional, default is "mysql-db-host"
    WEED_MYSQL_INTERPOLATEPARAMS : str, optional, default is "true"
        enable usage of memsql as filer backend
    WEED_MYSQL_PORT : str, optional, default is "3306"
    """
    [...str]: any
    WEED_FILER_BUCKETS_FOLDER?: str
    WEED_FILER_OPTIONS_RECURSIVE_DELETE?: str
    WEED_LEVELDB2_ENABLED?: str
    WEED_MYSQL_CONNECTION_MAX_IDLE?: str
    WEED_MYSQL_CONNECTION_MAX_LIFETIME_SECONDS?: str
    WEED_MYSQL_CONNECTION_MAX_OPEN?: str
    WEED_MYSQL_DATABASE?: str
    WEED_MYSQL_ENABLED?: str
    WEED_MYSQL_HOSTNAME?: str
    WEED_MYSQL_INTERPOLATEPARAMS?: str
    WEED_MYSQL_PORT?: str

schema ValuesFilerIngresses:
    r"""
    ValuesFilerIngresses

    Attributes
    ----------
    grpc : ValuesFilerIngressesGrpc, optional
    http : ValuesFilerIngressesHttp, optional
    """
    [...str]: any
    grpc?: ValuesFilerIngressesGrpc
    http?: ValuesFilerIngressesHttp

schema ValuesFilerIngressesGrpc:
    r"""
    ValuesFilerIngressesGrpc

    Attributes
    ----------
    annotations : ValuesFilerIngressesGrpcAnnotations, optional
    className : str, optional, default is ""
    enabled : bool, optional, default is False
    host : str, optional, default is "seaweedfs.cluster.local"
    path : str, optional, default is "/"
        gRPC methods are called at /<package>.<Service>/<Method>, so route the
        whole host, not the HTTP UI's regex path.
    pathType : str, optional, default is "Prefix"
    tls : [any], optional
    """
    [...str]: any
    annotations?: ValuesFilerIngressesGrpcAnnotations
    className?: str
    enabled?: bool
    host?: str
    path?: str
    pathType?: str
    tls?: [any]

schema ValuesFilerIngressesGrpcAnnotations:
    r"""
    ValuesFilerIngressesGrpcAnnotations

    Attributes
    ----------
    "nginx.ingress.kubernetes.io/backend-protocol" : str, optional, default is "GRPC"
        Ingress terminates TLS and re-originates gRPC (HTTP/2) to the filer.
    """
    [...str]: any
    "nginx.ingress.kubernetes.io/backend-protocol"?: str

schema ValuesFilerIngressesHttp:
    r"""
    ValuesFilerIngressesHttp

    Attributes
    ----------
    annotations : ValuesFilerIngressesHttpAnnotations, optional
    className : str, optional, default is ""
    enabled : bool, optional, default is False
    host : str, optional, default is "seaweedfs.cluster.local"
        host: false for "*" hostname
    path : str, optional, default is "/sw-filer/?(.*)"
    pathType : str, optional, default is "ImplementationSpecific"
    tls : [any], optional
        nginx.ingress.kubernetes.io/backend-protocol: GRPC
        nginx.ingress.kubernetes.io/auth-type: "basic"
        nginx.ingress.kubernetes.io/auth-secret: "default/ingress-basic-auth-secret"
        nginx.ingress.kubernetes.io/auth-realm: 'Authentication Required - SW-Filer'
        nginx.ingress.kubernetes.io/service-upstream: "true"
        nginx.ingress.kubernetes.io/rewrite-target: /$1
        nginx.ingress.kubernetes.io/use-regex: "true"
        nginx.ingress.kubernetes.io/enable-rewrite-log: "true"
        nginx.ingress.kubernetes.io/ssl-redirect: "false"
        nginx.ingress.kubernetes.io/force-ssl-redirect: "false"
        nginx.ingress.kubernetes.io/configuration-snippet: |
          sub_filter '<head>' '<head> <base href="/sw-filer/">'; #add base url
          sub_filter '="/' '="./';                               #make absolute paths to relative
          sub_filter '=/' '=./';
          sub_filter '/seaweedfsstatic' './seaweedfsstatic';
          sub_filter_once off;
    """
    [...str]: any
    annotations?: ValuesFilerIngressesHttpAnnotations
    className?: str
    enabled?: bool
    host?: str
    path?: str
    pathType?: str
    tls?: [any]

