schema ValuesFilerS3:
    r"""
    ValuesFilerS3

    Attributes
    ----------
    auditLogConfig : ValuesFilerS3AuditLogConfig, optional
        To provide explicit credentials for the S3 gateway, set them under
        the top-level s3.credentials key (not filer.s3.credentials).
        The s3-secret.yaml template only reads from .Values.s3.credentials.
        See: s3.credentials.admin.accessKey, s3.credentials.read.accessKey
    createBucketsHook : ValuesFilerS3CreateBucketsHook, optional
        You may specify buckets to be created during the install or upgrade process.
        Buckets may be exposed publicly by setting `anonymousRead` to `true`
        ttl format: [1-255][m|h|d|w|M|y] (e.g., 7d)
        objectLock enables S3 Object Lock (irreversible, forces versioning)
        versioning: Enabled or Suspended (or bool true/false)
        createBuckets:
          - name: bucket-a
            anonymousRead: true
            ttl: 7d
            objectLock: true
            versioning: Enabled
          - name: bucket-b
            anonymousRead: false
    domainName : str, optional, default is ""
        Suffix of the host name, {bucket}.{domainName}
    enableAuth : bool, optional, default is False
        enable user & permission to s3 (need to inject to all services)
    enabled : bool, optional, default is False
    existingConfigSecret : any, optional, default is "null"
        set to the name of an existing kubernetes Secret with the s3 json config file
        should have a secret key called seaweedfs_s3_config with an inline json configure
    httpsPort : int, optional, default is 0
        add additional https port
    port : int, optional, default is 8333
    """
    [...str]: any
    auditLogConfig?: ValuesFilerS3AuditLogConfig
    createBucketsHook?: ValuesFilerS3CreateBucketsHook
    domainName?: str
    enableAuth?: bool
    enabled?: bool
    existingConfigSecret?: any
    httpsPort?: int
    port?: int

schema ValuesFilerS3AuditLogConfig:
