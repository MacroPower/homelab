schema ValuesGlobal:
    r"""
    Allows for configuring chart-wide settings

    Attributes
    ----------
    alwaysAppendIdentifierToResourceName : bool, optional, default is False
        Always append identifier slugs to resource names, regardless of the enabled resource count.
    annotations : any, optional
        Set additional global annotations.
    createDefaultServiceAccount : bool, optional, default is True
        When true (default), automatically create a dedicated ServiceAccount using the release name as the identifier if no serviceAccount is explicitly configured. If any serviceAccount entries are present, the default is not created and user configuration takes precedence.
    fullnameOverride : str, optional
        Set the chart fullname definition
    labels : any, optional
        Set additional global labels.
    nameOverride : str, optional
        Set the chart name
    propagateGlobalMetadataToPods : bool, optional, default is False
        Set to true to propagate global metadata to Pod labels.
    templateEvaluation : ValuesGlobalTemplateEvaluation, optional
        Configure global string template evaluation.
    """
    alwaysAppendIdentifierToResourceName?: bool
    annotations?: any
    createDefaultServiceAccount?: bool
    fullnameOverride?: str
    labels?: any
    nameOverride?: str
