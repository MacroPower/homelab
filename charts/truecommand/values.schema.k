schema ValuesPersistence:
    r"""
    Configure persistent storage and mount options. Each key is an identifier for a persistence item.
    Supported types: persistentVolumeClaim (default), configMap, secret, nfs, emptyDir, hostPath, image, projected, custom.
    By default each item mounts to /<identifier>. Use globalMounts or advancedMounts to customize mount paths.
    """
    [...str]: ValuesPersistenceAdditionalProperties

schema ValuesPersistenceAdditionalProperties:
    r"""
    Specify a custom volume type not covered by the built-in types. The volumeSpec is passed through directly to the pod spec.

    Attributes
    ----------
    accessMode : str, optional
        AccessMode for the ephemeral volume. Make sure to select an access mode that is supported by your storage provider!
        See https://kubernetes.io/docs/concepts/storage/persistent-volumes/#access-modes
    advancedMounts : any, optional
        Explicitly configure mounts for specific controllers and containers.
        Structure: advancedMounts.<controller_name>.<container_name>[].path
        Use this instead of globalMounts when different controllers need different mount configurations.
    annotations : any, optional
        Annotations to set on the item. Keys and values support Helm templating.
    dataSource : ValuesPersistenceAdditionalPropertiesDataSource, optional
        The optional data source for the persistentVolumeClaim.
        See https://kubernetes.io/docs/concepts/storage/persistent-volumes/#volume-populators-and-data-sources
    dataSourceRef : ValuesPersistenceAdditionalPropertiesDataSourceRef, optional
        The optional volume populator for the persistentVolumeClaim.
        See https://kubernetes.io/docs/concepts/storage/persistent-volumes/#volume-populators-and-data-sources
    defaultMode : int, optional
        Permissions applied to the projected files, in octal (for example 0400). Individual items may override this.
    enabled : bool, optional, default is True
        Set to false to disable the persistence item.
    existingClaim : str, optional
        The name of an existing PersistentVolumeClaim to use.
        This will not create a new PVC, but use the existing one instead.
    externalSecretRef : str, optional
    forceRename : str, optional
        Override the default resource name. Mutually exclusive with prefix and suffix.
    globalMounts : [ValuesPersistenceAdditionalPropertiesGlobalMountsItems0], optional
        Configure mounts to all controllers and containers.
        By default the persistence item will be mounted to /<name_of_the_persistence_item>.
        Each entry supports: path, readOnly, subPath, subPathExpr, and mountPropagation.
    hostPath : str, optional
        Path on the host node to mount.
    hostPathType : str, optional
        Type of the host path. Values: DirectoryOrCreate, Directory, FileOrCreate, File, Socket, CharDevice, BlockDevice.
    identifier : str, optional
    image : ValuesPersistenceAdditionalPropertiesImage, optional
        OCI artifact reference to be used.
    items : [ValuesPersistenceAdditionalPropertiesItemsItems0], optional
    labels : any, optional
        Labels to set on the item. Keys and values support Helm templating.
    medium : str, optional
        Storage medium. Set to 'Memory' for tmpfs (RAM-backed). Leave empty for node disk.
    name : str, optional
    path : str, optional
        The NFS export path on the server.
    prefix : str, optional, default is ""
        Prefix to prepend to the resource name. Mutually exclusive with forceRename.
    pullPolicy : "Always" | "Never" | "IfNotPresent", optional
        The image pull policy for the image persistence item.
    retain : bool, optional
        Set to true to retain the PVC upon helm uninstall.
    server : str, optional
        The NFS server hostname or IP address.
    size : str, optional
        The amount of storage that is requested for the ephemeral volume.
    sizeLimit : str, optional
        Maximum size of the volume (e.g. '1Gi'). Only enforced for tmpfs.
    sources : [ValuesPersistenceAdditionalPropertiesSourcesItems0], optional
        The list of volume projections to mount into this volume.
    storageClass : str, optional
        Storage Class for the ephemeral volume.
        If set to '-', dynamic provisioning is disabled.
        If set to something else, the given storageClass is used.
        If undefined (the default) or set to null, no storageClassName spec is set, choosing the default provisioner.
    suffix : str, optional
        Suffix to append to the resource name. Defaults to the resource identifier if there are multiple items, otherwise empty. Mutually exclusive with forceRename.
    $type : any, optional
    volumeName : str, optional
    volumeSpec : ValuesPersistenceAdditionalPropertiesVolumeSpec, optional
        Raw Kubernetes volume specification. Passed through directly to the pod spec volumes list.
    """
    accessMode?: str
    advancedMounts?: any
    annotations?: any
    dataSource?: ValuesPersistenceAdditionalPropertiesDataSource
    dataSourceRef?: ValuesPersistenceAdditionalPropertiesDataSourceRef
    defaultMode?: int
    enabled?: bool
    existingClaim?: str
    externalSecretRef?: str
    forceRename?: str
    globalMounts?: [ValuesPersistenceAdditionalPropertiesGlobalMountsItems0]
    hostPath?: str
    hostPathType?: str
    identifier?: str
    image?: ValuesPersistenceAdditionalPropertiesImage
    items?: [ValuesPersistenceAdditionalPropertiesItemsItems0]
    labels?: any
    medium?: str
    name?: str
    path?: str
    prefix?: str
    pullPolicy?: "Always" | "Never" | "IfNotPresent"
    retain?: bool
    server?: str
    size?: str
    sizeLimit?: str
    sources?: [ValuesPersistenceAdditionalPropertiesSourcesItems0]
    storageClass?: str
    suffix?: str
    $type?: any
    volumeName?: str
    volumeSpec?: ValuesPersistenceAdditionalPropertiesVolumeSpec

    check:
        len(sources) >= 1 if sources

