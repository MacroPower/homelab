schema ValuesNetworkpoliciesAdditionalProperties:
    r"""
    Cluster-scoped CiliumClusterwideNetworkPolicy implementation to render. The resource is rendered without metadata.namespace.

    Attributes
    ----------
    annotations : any, optional
        Annotations to set on the item. Keys and values support Helm templating.
    controller : str, optional
        Controller this CiliumNetworkPolicy should target. Mutually exclusive with controllers and endpointSelector.
    controllers : [str], optional
        Controllers this CiliumNetworkPolicy should target. Each entry can be an exact controller identifier or a regular expression. Mutually exclusive with controller and endpointSelector.
    description : str, optional
        Human-readable description of the policy.
    egress : [ValuesNetworkpoliciesAdditionalPropertiesEgressItems0], optional
        Egress allow rules. At most one peer selector may be set. toPorts may be combined with a peer selector; icmps may not.
    egressDeny : [ValuesNetworkpoliciesAdditionalPropertiesEgressDenyItems0], optional
        Egress deny rules. At most one peer selector may be set. toPorts may be combined with a peer selector; icmps may not.
    enableDefaultDeny : ValuesNetworkpoliciesAdditionalPropertiesEnableDefaultDeny, optional
        Configure whether the selected endpoints enter default-deny mode for ingress and egress traffic.
    enabled : bool, optional, default is True
        Set to false to disable the CiliumNetworkPolicy.
    endpointSelector : ValuesNetworkpoliciesAdditionalPropertiesEndpointSelector, optional
        Custom endpointSelector for the CiliumNetworkPolicy. Mutually exclusive with controller and controllers.
    extraSelectorLabels : ValuesNetworkpoliciesAdditionalPropertiesExtraSelectorLabels, optional
        Additional match labels to add to the endpoint selector. These are merged with labels derived from the controller selection.
    forceRename : str, optional
        Override the default resource name. Mutually exclusive with prefix and suffix.
    ingress : [ValuesNetworkpoliciesAdditionalPropertiesIngressItems0], optional
        Ingress allow rules. At most one peer selector may be set. toPorts may be combined with a peer selector; icmps may not.
    ingressDeny : [ValuesNetworkpoliciesAdditionalPropertiesIngressDenyItems0], optional
        Ingress deny rules. At most one peer selector may be set. toPorts may be combined with a peer selector; icmps may not.
    labels : any, optional
        Labels to set on the item. Keys and values support Helm templating.
    log : str, optional
        Free-form value included in Hubble flows matching this policy.
    nodeSelector : ValuesNetworkpoliciesAdditionalPropertiesNodeSelector, optional
        Node selector for a CiliumClusterwideNetworkPolicy.
    podSelector : any, optional
        Custom podSelector for the NetworkPolicy. Mutually exclusive with controller and controllers.
    policyTypes : ["Egress" | "Ingress"], optional
        Policy types for the NetworkPolicy.
    prefix : str, optional, default is ""
        Prefix to prepend to the resource name. Mutually exclusive with forceRename.
    rules : ValuesNetworkpoliciesAdditionalPropertiesRules, optional
        Ingress and egress rules for the NetworkPolicy. See https://kubernetes.io/docs/concepts/services-networking/network-policies/#networkpolicy-resource for details. Use `- {}` as an item to allow all traffic for that direction.
    suffix : str, optional
        Suffix to append to the resource name. Defaults to the resource identifier if there are multiple items, otherwise empty. Mutually exclusive with forceRename.
    $type : "native" | "cilium" | "ciliumClusterwide" | "native", optional
        Resource implementation to render.
    """
    annotations?: any
    controller?: str
    controllers?: [str]
    description?: str
    egress?: [ValuesNetworkpoliciesAdditionalPropertiesEgressItems0]
    egressDeny?: [ValuesNetworkpoliciesAdditionalPropertiesEgressDenyItems0]
    enableDefaultDeny?: ValuesNetworkpoliciesAdditionalPropertiesEnableDefaultDeny
    enabled?: bool
    endpointSelector?: ValuesNetworkpoliciesAdditionalPropertiesEndpointSelector
    extraSelectorLabels?: ValuesNetworkpoliciesAdditionalPropertiesExtraSelectorLabels
    forceRename?: str
    ingress?: [ValuesNetworkpoliciesAdditionalPropertiesIngressItems0]
    ingressDeny?: [ValuesNetworkpoliciesAdditionalPropertiesIngressDenyItems0]
    labels?: any
    log?: str
    nodeSelector?: ValuesNetworkpoliciesAdditionalPropertiesNodeSelector
    podSelector?: any
    policyTypes?: ["Egress" | "Ingress"]
    prefix?: str
    rules?: ValuesNetworkpoliciesAdditionalPropertiesRules
    suffix?: str
    $type?: "native" | "cilium" | "ciliumClusterwide" | "native"

    check:
        len(controllers) >= 1 if controllers
        len(egress) >= 1 if egress
        len(egressDeny) >= 1 if egressDeny
        len(ingress) >= 1 if ingress
        len(ingressDeny) >= 1 if ingressDeny
        len(log) <= 32 if log
        len(policyTypes) >= 1 if policyTypes

